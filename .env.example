# Local wiring test only. Do not reuse this value on a remote model server.
MOCK_API_KEY=local-mock-only
MOCK_BASE_URL=http://127.0.0.1:18080/v1

# The automated RunPod workflow generates this secret in .runpod/api-key.
# These values are only needed when invoking the Bash gate manually.
LLAMACPP_API_KEY=load-from-dot-runpod-api-key
LLAMACPP_BASE_URL=http://127.0.0.1:18080/v1

# Optional on the Pod for gated Hugging Face repositories. Both pinned GGUF
# repositories are public and do not currently require a token.
HF_TOKEN=

# Provider control key used only by scripts/runpod-provision.ps1 -Execute.
# Set this in the current process; never commit a real value or reuse the
# llama-server key from .runpod/api-key.
RUNPOD_API_KEY=
