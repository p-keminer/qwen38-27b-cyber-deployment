# Generated evaluation artifacts can contain complete prompts and responses.
artifacts/logs/*
artifacts/mock-api/*
artifacts/benchmarks/*
artifacts/reviews/*
artifacts/recovered-documentation/*
artifacts/acceptance/*
!artifacts/logs/.gitkeep
!artifacts/mock-api/.gitkeep
!artifacts/benchmarks/.gitkeep
!artifacts/reviews/.gitkeep
results/runs/*
!results/runs/.gitkeep

# Local process state
*.pid

# Local RunPod connection state and generated API key
.runpod/

# Remote deployment directories if a bundle is tested locally
/models/
/runtime/
/state/
/cache/
/logs/

# Local packaging/build output
build/
dist/
*.egg-info/
*.gguf
