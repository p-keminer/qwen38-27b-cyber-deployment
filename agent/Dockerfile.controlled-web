FROM node:24.14.0-bookworm-slim@sha256:d8e448a56fc63242f70026718378bd4b00f8c82e78d20eefb199224a4d8e33d8

RUN groupadd --gid 10002 controlled-web \
    && useradd --uid 10002 --gid 10002 --no-create-home \
        --home-dir /nonexistent --shell /usr/sbin/nologin controlled-web

WORKDIR /app
COPY --chown=10002:10002 controlled-web-proxy.mjs /app/controlled-web-proxy.mjs

ENV CONTROLLED_WEB_LISTEN_HOST=0.0.0.0 \
    CONTROLLED_WEB_LISTEN_PORT=3128

USER 10002:10002
EXPOSE 3128
ENTRYPOINT ["node", "/app/controlled-web-proxy.mjs"]
